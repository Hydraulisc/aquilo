<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Direct Messages | <%- title %></title>
    <link rel="shortcut icon" href="/assets/favicon.webp" type="image/x-icon">
    <link rel="icon" type="image/png" href="/assets/favicon.webp">
    <link rel="stylesheet" href="/css/appStyles.css">
    <link rel="stylesheet" href="/css/messagesStyle.css">
    <script src="/js/themeSelector.js"></script>
</head>
<body>
    <div class="app">
        <div class="appContainer">
            <div class="chatNavContainer">
                <div class="sideBarContainer">
                    <!-- Server list (left column) -->
                    <div class="serverListContainer">
                        <div class="serverList">
                            <div>
                                <div class="userProfilePicContainer">
                                    <div class="userProfilePic">
                                        <div class="itemContainer">
                                            <a href="/">
                                                <div>
                                                    <span>
                                                        <svg class="userSelectNone" width="42" height="42" viewBox="0 0 32 32">
                                                            <foreignObject x="0" y="0" width="32" height="32">
                                                                <% if (!ownPfp || ownPfp === 'null' || ownPfp === '') { %>
                                                                    <img src="/assets/1759430838.png" class="navSelectIcons">
                                                                <% } else { %>
                                                                    <img src="<%- ownPfp %>" class="profilePic navSelectIcons">
                                                                <% } %>
                                                            </foreignObject>
                                                        </svg>
                                                    </span>
                                                </div>
                                            </a>
                                            <div class="separator"></div>
                                        </div>
                                    </div>
                                    <% for (const server of servers) { %>
                                        <div>
                                            <div class="itemContainer">
                                                <div>
                                                    <span>
                                                        <a href="/server/<%- server.id %>">
                                                            <svg width="42" height="42" viewBox="0 0 32 32">
                                                                <foreignObject x="0" y="0" width="32" height="32">
                                                                    <img src="<%- server.icon || '/assets/1759430838.png' %>" class="navSelectIcons">
                                                                </foreignObject>
                                                            </svg>
                                                        </a>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="itemContainer">
                            <a href="/settings">
                                <div>
                                    <svg class="userSelectNone" width="42" height="42" viewBox="0 0 32 32">
                                        <foreignObject x="0" y="0" width="32" height="32">
                                            <div class="gafLvO">
                                                <svg viewBox="0 0 20 20" version="1.1" xmlns="http://www.w3.org/2000/svg" fill="var(--text-color)" width="23px" height="23px">
                                                    <g id="SVGRepo_iconCarrier"><g id="layer1"><path d="M 9.9980469 0 L 9.328125 0.0234375 L 8.6621094 0.08984375 L 8 0.203125 L 8 2.2539062 L 7.4628906 2.4121094 L 6.9375 2.609375 L 6.4277344 2.8398438 L 5.9375 3.1074219 L 4.4863281 1.6582031 L 3.9375 2.046875 L 3.4199219 2.4707031 L 2.9296875 2.9296875 L 2.4726562 3.4179688 L 2.046875 3.9394531 L 1.6582031 4.484375 L 3.1074219 5.9375 L 2.8417969 6.4296875 L 2.609375 6.9394531 L 2.4140625 7.4628906 L 2.2539062 8 L 0.203125 8 L 0.091796875 8.6621094 L 0.0234375 9.3300781 L 0 10 L 0.0234375 10.669922 L 0.091796875 11.339844 L 0.203125 12 L 2.2539062 12 L 2.4140625 12.539062 L 2.609375 13.060547 L 2.8417969 13.570312 L 3.1074219 14.064453 L 1.6582031 15.515625 L 2.046875 16.060547 L 2.4726562 16.582031 L 2.9296875 17.070312 L 3.4199219 17.529297 L 3.9375 17.953125 L 4.4863281 18.341797 L 5.9375 16.892578 L 6.4277344 17.160156 L 6.9375 17.390625 L 7.4628906 17.587891 L 8 17.746094 L 8 19.796875 L 8.6621094 19.910156 L 9.328125 19.978516 L 9.9980469 20 L 10.671875 19.978516 L 11.337891 19.910156 L 12 19.796875 L 12 17.746094 L 12.537109 17.587891 L 13.0625 17.390625 L 13.572266 17.160156 L 14.0625 16.892578 L 15.513672 18.341797 L 16.058594 17.953125 L 16.580078 17.529297 L 17.070312 17.070312 L 17.527344 16.582031 L 17.953125 16.060547 L 18.341797 15.515625 L 16.888672 14.064453 L 17.158203 13.570312 L 17.390625 13.060547 L 17.585938 12.539062 L 17.746094 12 L 19.796875 12 L 19.908203 11.339844 L 19.976562 10.669922 L 20 10 L 19.976562 9.3300781 L 19.908203 8.6621094 L 19.796875 8 L 17.746094 8 L 17.585938 7.4628906 L 17.390625 6.9394531 L 17.158203 6.4296875 L 16.888672 5.9375 L 18.341797 4.484375 L 17.953125 3.9394531 L 17.527344 3.4179688 L 17.070312 2.9296875 L 16.580078 2.4707031 L 16.058594 2.046875 L 15.513672 1.6582031 L 14.0625 3.1074219 L 13.572266 2.8398438 L 13.0625 2.609375 L 12.537109 2.4121094 L 12 2.2539062 L 12 0.203125 L 11.337891 0.08984375 L 10.671875 