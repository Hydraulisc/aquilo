7.0625 L 9.796875 7.0078125 z " style="fill:var(--text-color);stroke:var(--text-color);stroke-width:0.3px;"></path></g></g>
                                                </svg>
                                            </div>
                                        </foreignObject>
                                    </svg>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- DM conversation list (channel sidebar equivalent) -->
                    <div class="channelsListContainer JkpVA">
                        <div class="jXEHHp channelsHeader">
                            <div class="container">
                                <p class="title">Direct Messages</p>
                            </div>
                        </div>
                        <div class="channelsSidebar cJgFyc" id="dm-list">
                            <% if (conversations.length === 0) { %>
                                <div style="padding:12px; font-size:12px; color:var(--text-muted,#aaa); opacity:0.7;">No conversations yet.<br>Click a user's profile to start one.</div>
                            <% } %>
                            <% for (const convo of conversations) { %>
                                <a href="/dm/<%= convo.partnerId %>">
                                    <div class="_item_1avxi_1 _compact_1avxi_19" style="display:flex; align-items:center; gap:8px;<%= partnerId == convo.partnerId ? ' background: var(--accent-color) !important;' : '' %>">
                                        <svg width="28" height="28" viewBox="0 0 32 32" style="flex-shrink:0;">
                                            <foreignObject x="0" y="0" width="32" height="32">
                                                <img src="<%- convo.ownPfp || '/assets/1759430838.png' %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                                            </foreignObject>
                                        </svg>
                                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= convo.username %></span>
                                        <span class="dm-unread-badge" data-partner-id="<%= convo.partnerId %>" style="margin-left:auto; background:var(--accent-color,#5865f2); color:#fff; border-radius:10px; font-size:10px; padding:1px 6px; <%= convo.unread ? '' : 'display:none;' %>"><%= convo.unread || '' %></span>
                                        <% if (convo.encryptionMode !== 'none') { %>
                                            <span style="opacity:0.6; color:var(--text-color,#fff);" title="<%= convo.encryptionMode === 'pgp' ? 'PGP' : 'AES' %> encrypted"><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px;"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg></span>
                                        <% } %>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Main DM area -->
                <div class="_3LgFW">
                    <% if (!partnerId) { %>
                    <div style="display:flex; align-items:center; justify-content:center; height:100%; flex-direction:column; gap:12px; opacity:0.5;">
                        <p style="font-size:18px; font-weight:600;">Direct Messages</p>
                        <p style="font-size:13px;">Select a conversation or open a user's profile to start one.</p>
                    </div>
                    <% } else { %>
                    <div class="hpNYLK">
                        <div class="fPzJRX">
                            <div class="channelHeader cnyIwU" style="display:flex; align-items:center; gap:10px;">
                                <svg width="28" height="28" viewBox="0 0 32 32">
                                    <foreignObject x="0" y="0" width="32" height="32">
                                        <img src="<%- partnerPfp || '/assets/1759430838.png' %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                                    </foreignObject>
                                </svg>
                                <span class="channelTitle"><%= partnerUsername %></span>
                                <span style="margin-left:auto; display:inline-flex; align-items:center; gap:6px; color:var(--text-color,#fff);">
                                    <% if (encryptionMode === 'none') { %>
                                        <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor"><path d="M11 1a2 2 0 0 0-2 2v4a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h5V3a3 3 0 0 1 6 0v4a.5.5 0 0 1-1 0V3a2 2 0 0 0-2-2z"/></svg>
                                    <% } else { %>
                                        <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                                    <% } %>
                                    <select id="dm-mode-select" title="Encryption mode for this conversation"
                                            style="padding:4px 8px; font-size:12px; cursor:pointer; border-radius:12px; border:1px solid var(--border-color,#444); background:var(--bg-tertiary,#1e1f22); color:var(--text-color,#fff); outline:none;">
                                        <option value="none" <%= encryptionMode === 'none' ? 'selected' : '' %>>Plaintext</option>
                                        <option value="aes" <%= encryptionMode === 'aes' ? 'selected' : '' %>>AES (automatic)</option>
                                        <option value="pgp" <%= encryptionMode === 'pgp' ? 'selected' : '' %>>PGP-only (manual)</option>
                                    </select>
                                </span>
                            </div>

                            <div class="channelHeaderCTA gZuxBC"></div>
                        </div>

                        <div class="messageAreaPadding" style="overflow-y:auto; flex:1;">
                            <div class="messageArea" id="dm-message-area"></div>
                        </div>

                        <div id="dm-reply-bar" style="display:none; padding:4px 16px; font-size:12px; color:var(--text-muted,#aaa);">
                            Replying to <span id="dm-reply-bar-user"></span>
                            <a href="#" id="dm-reply-bar-cancel" style="margin-left:8px;">✕</a>
                        </div>
                        <div id="dm-typing-indicator" style="min-height:18px; padding:0 16px; font-size:12px; color:var(--text-muted,#aaa);"></div>
                        <div style="padding: 0 16px 16px;">
                            <% if (encryptionMode === 'pgp') { %>
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px; font-size:11px; color:var(--text-muted,#aaa);">
                                <span style="display:inline-flex; align-items:center; gap:4px;"><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg> PGP-only conversation</span>
                                <span id="dm-armor-status" style="margin-left:auto;"></span>
                            </div>
                            <% } %>
                            <textarea id="dm-input" maxlength="64000" placeholder="<% if (encryptionMode === 'pgp') { %>Paste PGP ciphertext…<% } else if (partnerUsername === 'Note to self') { %>Note to self…<% } else { %>Message <%= partnerUsername %>…<% } %>" style="width:100%; box-sizing:border-box; resize:none; min-height:44px; padding:10px 14px; background:var(--input-bg,#383a40); color:var(--text-color,#fff); border:none; border-radius:8px; font-size:14px; font-family:inherit; outline:none;"></textarea>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- DM unlock modal -->
    <div id="dm-unlock-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--bg-secondary,#2b2d31); border-radius:8px; padding:24px; width:480px; max-width:90vw;">
            <h3 style="margin:0 0 8px; color:var(--text-color);">Unlock Direct Messages</h3>

            <div id="dm-unlock-step-1">
                <p style="margin:0 0 16px; font-size:13px; color:var(--text-muted,#aaa);">DMs require PGP verification. Click to generate a challenge encrypted with your registered public key.</p>
                <button id="dm-get-challenge-btn" style="padding:8px 20px; background:var(--accent-color,#5865f2); color:#fff; border:none; border-radius:4px; cursor:pointer;">Get Challenge</button>
            </div>

            <div id="dm-unlock-step-2" style="display:none;">
                <p style="margin:0 0 8px; font-size:13px; color:var(--text-muted,#aaa);">Decrypt with your private key, paste the result below.</p>
                <textarea id="dm-challenge-output" rows="6" readonly style="width:100%; box-sizing:border-box; font-family:monospace; font-size:11px; background:var(--bg-tertiary,#1e1f22); color:var(--text-muted,#aaa); border:1px solid var(--border-color,#444); border-radius:4px; padding:8px; resize:none;"></textarea>
                <p style="margin:12px 0 6px; font-size:13px; color:var(--text-muted,#aaa);">Decrypted result:</p>
                <input id="dm-plaintext-input" type="text" style="width:100%; box-sizing:border-box; font-family:monospace; font-size:13px; background:var(--bg-tertiary,#1e1f22); color:var(--text-color); border:1px solid var(--border-color,#444); border-radius:4px; padding:8px;" placeholder="Paste decrypted text">
                <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
                    <button id="dm-unlock-btn" style="padding:8px 20px; background:var(--accent-color,#5865f2); color:#fff; border:none; border-radius:4px; cursor:pointer;">Verify</button>
                    <span id="dm-unlock-error" style="font-size:12px; color:#f04747;"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- AES conversation key modal -->
    <div id="dm-aes-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--bg-secondary,#2b2d31); border-radius:8px; padding:24px; width:480px; max-width:90vw;">
            <h3 style="margin:0 0 8px; color:var(--text-color);">Unlock AES conversation</h3>
            <p style="margin:0 0 8px; font-size:13px; color:var(--text-muted,#aaa);">Decrypt the conversation key below with your PGP private key, then paste the 64-character hex result. The key stays in this tab only.</p>
            <textarea id="dm-aes-wrapped" rows="6" readonly style="width:100%; box-sizing:border-box; font-family:monospace; font-size:11px; background:var(--bg-tertiary,#1e1f22); color:var(--text-muted,#aaa); border:1px solid var(--border-color,#444); border-radius:4px; padding:8px; resize:none;"></textarea>
            <p style="margin:12px 0 6px; font-size:13px; color:var(--text-muted,#aaa);">Decrypted key (hex):</p>
            <input id="dm-aes-hex-input" type="text" autocomplete="off" style="width:100%; box-sizing:border-box; font-family:monospace; font-size:13px; background:var(--bg-tertiary,#1e1f22); color:var(--text-color); border:1px solid var(--border-color,#444); border-radius:4px; padding:8px;" placeholder="64 hex characters">
            <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
                <button id="dm-aes-unlock-btn" style="padding:8px 20px; background:var(--accent-color,#5865f2); color:#fff; border:none; border-radius:4px; cursor:pointer;">Unlock</button>
                <button id="dm-aes-cancel-btn" style="padding:8px 20px; background:transparent; color:var(--text-color,#fff); border:1px solid var(--border-color,#444); border-radius:4px; cursor:pointer;">Cancel</button>
                <span id="dm-aes-error" style="font-size:12px; color:#f04747;"></span>
            </div>
        </div>
    </div>

    <%- include('../partials/profileModal') %>
    <script src="/js/profileModal.js"></script>

    <div id="dm-context"
         data-partner-id="<%= partnerId || '' %>"
         data-partner-username="<%= partnerUsername || '' %>"
         data-partner-pfp="<%= partnerPfp || '' %>"
         data-own-uid="<%= uid %>"
         data-own-username="<%= username %>"
         data-own-pfp="<%= ownPfp || '' %>"
         data-encryption-mode="<%= encryptionMode %>"
         data-partner-fingerprint="<%= partnerFingerprint || '' %>"
         data-unlocked="<%= isUnlocked %>"
         hidden></div>
    <script src="/js/vendor/openpgp.min.js"></script>
    <script src="/js/dm.js"></script>
</body>
</html>
