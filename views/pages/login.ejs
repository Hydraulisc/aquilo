<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/favicon.webp" type="image/x-icon">
    <link rel="icon" type="image/png" href="/assets/favicon.webp">
    <title>Sign In | Aquilo</title>
    <link rel="stylesheet" href="/css/loginPageStyles.css">
    <script src="/js/themeSelector.js"></script>
</head>
<body>
    <div class="frame">
        <div class="tab-spacer"></div>
        <div class="panel">
            <div class="panel-left">
                <div class="brand">
                    <span class="brand-dot"></span>
                    AQUILO
                </div>
                <h1 class="hero">OAUTH</h1>
                <p class="subtext">
                    Aquilo uses OAuth to collect as little data about you as possible. Furthermore, we use <a href="https://github.com/sooox-cc/pgp-verification" target="_blank" rel="noopener noreferrer">PGP-As-Verification</a> technologies for Multi-Factor Authentication, encryption, and to confirm you're the key-holder.
                </p>
            </div>
            <div class="mobile_display_override">
                <div class="brand">
                    <span class="brand-dot"></span>
                    AQUILO
                </div>
            </div>
            <div class="panel-right">
                <div class="card" id="register-form">
                    <div class="tab-spacer"></div>
                    <h2 class="card-title">Sign in to your account</h2>
                    <a href="/oauth/login<%= next !== '/' ? `?next=${encodeURIComponent(next)}` : '' %>" class="submit-btn">
                        LOGIN ON HYDRAULISC
                        <span aria-hidden="true">→</span>
                    </a>
                    <div class="tab-spacer"></div>
                    <div class="legal not-really">Need an account? <a href="https://hydraulisc.net/register" target="_blank" rel="noopener noreferrer">Sign up on Hydraulisc</a>. It's free, and KYC-less!</div>
                    <hr class="divider">
                    <div class="legal">
                        by continuing, you agree you have read and understood our <a href="/canary">warrant canary</a>, and agree to abide by our <a href="about:blank">terms of service</a> and <a href="about:blank">privacy policy</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
