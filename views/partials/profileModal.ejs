<div id="profile-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:2000; align-items:center; justify-content:center;">
    <div style="background:var(--bg-secondary,#2b2d31); border-radius:8px; padding:24px; width:480px; max-width:90vw; position:relative;">
        <button id="profile-modal-close" style="position:absolute; top:12px; right:12px; background:none; border:none; color:var(--text-muted,#aaa); font-size:18px; cursor:pointer;">✕</button>
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:20px;">
            <svg width="48" height="48" viewBox="0 0 32 32">
                <foreignObject x="0" y="0" width="32" height="32">
                    <img id="profile-modal-pfp" src="" alt="" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
                </foreignObject>
            </svg>
            <div>
                <div id="profile-modal-username" style="font-size:18px; font-weight:600; color:var(--text-color,#fff);"></div>
                <div style="font-size:11px; color:var(--text-muted,#aaa); margin-top:2px;">PGP fingerprint:</div>
                <div id="profile-modal-fingerprint" style="font-family:monospace; font-size:11px; color:var(--text-muted,#aaa); word-break:break-all;"></div>
            </div>
        </div>
        <div style="display:flex; gap:8px;">
            <a id="profile-modal-dm" href="#" style="display:none; padding:6px 16px; background:var(--accent-color,#5865f2); color:#fff; border-radius:4px; font-size:12px; text-decoration:none;">Send DM</a>
            <button id="profile-modal-copy" style="padding:6px 16px; background:transparent; color:var(--text-color,#fff); border:1px solid var(--border-color,#444); border-radius:4px; cursor:pointer; font-size:12px;">Copy public key</button>
        </div>
        <div id="profile-modal-error" style="margin-top:8px; font-size:12px; color:#f04747;"></div>
    </div>
</div>
